# ─── Keshav Turbo Services — Environment Variables ────────────────────────────
# DO NOT commit this file to Git. It is listed in .gitignore.
#
# FOR LOCAL DEV: fill values here and save as .env in your project root.
#
# FOR CLOUDFLARE PAGES PRODUCTION:
#   Dashboard → your Pages project → Settings → Environment Variables
#   Add each variable for "Production" AND "Preview" environments.
#   Cloudflare injects them at build time — no .env file needed on the server.
# ──────────────────────────────────────────────────────────────────────────────

# Google Analytics 4 Measurement ID
# Get from: analytics.google.com → Admin → Data Streams → Web → Measurement ID
# Format: G-XXXXXXXXXX
VITE_GA4_ID=G-BEHMMEM13X

# Microsoft Clarity Project ID
# Get from: clarity.microsoft.com → your project → Settings → Setup
# Format: alphanumeric string ~10 chars
VITE_CLARITY_ID=wsmf3allv6

# Web3Forms Access Key
# Get from: web3forms.com → Dashboard → Access Keys
# Used by: InlineRFQForm (product pages) and ContactPage form submissions.
# Add to Cloudflare Pages: Settings → Environment Variables → VITE_WEB3FORMS_KEY
VITE_WEB3FORMS_KEY=2a9abce2-da52-4421-b692-f031c6c3d185