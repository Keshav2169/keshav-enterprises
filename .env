# ─── Keshav Enterprises — Environment Variables ───────────────────────────────
# Copy this file to your Vite project root (/keshavweb/.env).
# NEVER commit .env with real IDs to version control.
# Add .env to your .gitignore file.

# Google Analytics 4 Measurement ID
# Get from: Google Analytics → Admin → Data Streams → Web → Measurement ID
VITE_GA4_ID=G-YOURREALMEASUREMENTID

# Microsoft Clarity Project ID
# Get from: clarity.microsoft.com → Settings → Setup
VITE_CLARITY_ID=YOURREALIDHERE
