# ════════════════════════════════════════════════════════════════════
# _headers — Keshav Turbo Services
# Deploy to: /public/_headers
# Cloudflare Pages applies these to every response from the edge.
# ════════════════════════════════════════════════════════════════════

# ── Apply security headers to all pages ──────────────────────────
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-XSS-Protection: 1; mode=block

# ── Long-cache for immutable Vite build assets (hashed filenames) ─
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── Short cache for HTML — always revalidate ─────────────────────
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ── Medium cache for SEO/crawler files ───────────────────────────
/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
